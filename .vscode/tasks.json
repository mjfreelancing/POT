{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker-start-pot-server-only",
      "type": "shell",
      "command": "docker-compose --env-file .env --env-file .env.development -p pot -f docker-compose-server-only.yml up --build -d",
      "options": {
        "cwd": "${workspaceFolder}/Source/Docker"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "docker-stop-pot-server-only",
      "type": "shell",
      "command": "docker-compose --env-file .env --env-file .env.development -p pot -f docker-compose-server-only.yml down",
      "options": {
        "cwd": "${workspaceFolder}/Source/Docker"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": []
    },
    {
      "label": "docker-start-pot-client-server",
      "type": "shell",
      "command": "docker-compose --env-file .env --env-file .env.production -p pot -f docker-compose-client-server.yml up --build -d",
      "options": {
        "cwd": "${workspaceFolder}/Source/Docker"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": []
    },
    {
      "label": "docker-stop-pot-client-server",
      "type": "shell",
      "command": "docker-compose --env-file .env --env-file .env.production -p pot -f docker-compose-client-server.yml down",
      "options": {
        "cwd": "${workspaceFolder}/Source/Docker"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": []
    }
  ]
}
