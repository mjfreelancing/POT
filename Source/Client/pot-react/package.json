{
  "name": "pot-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --port 5175",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5175",
    "lint": "eslint  src/**/*.{ts,tsx}",
    "lint:fix": "eslint --fix src/**/*.{ts,tsx}",
    "lint:sort": "eslint --fix --fix-type layout,suggestion src/**/*.{ts,tsx}",
    "format:fix": "npm run lint:sort && npm run prettier",
    "prettier": "prettier . --write",
    "test": "vitest",
    "test:ui": "vitest --ui --api 9527 --coverage.enabled --coverage.provider=istanbul",
    "e2e": "npm run e2e:chromium",
    "e2e:dev": "playwright test --reporter=line",
    "e2e:prodlike": "playwright test --config=playwright.prod.config.ts --reporter=line",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:smoke": "playwright test --reporter=line e2e/tests/smoke",
    "e2e:smoke:headed": "playwright test e2e/tests/smoke --headed",
    "e2e:chromium": "playwright test --reporter=line --project chromium",
    "e2e:edge": "playwright test --reporter=line --project edge",
    "e2e:mobile": "playwright test --reporter=line --project mobile-chrome --project mobile-safari",
    "e2e:all": "npm run e2e:all:dev",
    "e2e:all:dev": "playwright test --project chromium --project edge --project mobile-chrome --project mobile-safari --reporter=line,html",
    "e2e:all:prodlike": "playwright test --config=playwright.prod.config.ts --project chromium --project edge --project mobile-chrome --project mobile-safari --reporter=line,html",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install chromium webkit",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^8.21.2",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "input-otp": "^1.5.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.525.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "^8.10.2",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.4",
    "react-hook-form": "^7.87.0",
    "react-router": "^7.18.3",
    "recharts": "^2.15.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.62.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "react-is": "^19.1.0",
    "react-day-picker": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "serialize-javascript": "^7.0.5"
  }
}
