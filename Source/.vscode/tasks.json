{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker-start-pot",
      "type": "shell",
      "command": "docker-compose -p pot -f Docker/docker-compose.yml up --build -d",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "docker-stop-pot",
      "type": "shell",
      "command": "docker-compose -p pot -f Docker/docker-compose.yml down",
