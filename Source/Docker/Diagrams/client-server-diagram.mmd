flowchart TD
    subgraph Docker Network
        subgraph "pot-postgres" [PostgreSQL Container]
            DB[(Database)]
            DB_Health["Healthcheck<br>pg_isready"]
        end

        subgraph "pot-aspnet" [ASP.NET Container]
            API["ASP.NET API<br>Port: 5241"]
            API_Health["Healthcheck:<br>_health endpoint"]
        end

        subgraph "pot-react" [React Container]
            Web["React App<br>Port: 80<br>Served by Nginx"]
        end

        DB --> DB_Health
        API --> API_Health
        DB_Health -->|"depends_on condition:<br>service_healthy"| API
        API -->|Internal Network| Web
    end

    Port_DB["Host Port: 5444"] -->|mapped to| DB
    Port_API["Host Port: 5241"] -->|mapped to| API
    Port_Web["Host Port: 5175"] -->|mapped to| Web

    Browser["External Browser"] -->|localhost:5175| Port_Web
