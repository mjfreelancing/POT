    subgraph "Host System"
        Dev["Developer Machine<br>React App (Dev Mode)"]
    end

    Port_DB["Host Port: 5444"] -->|mapped to| DB
    Port_API["Host Port: 5241"] -->|mapped to| API
    Dev -->|"VITE_API_BASE_URL=localhost:5241/api"| Port_API
