@using Models

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>POT - Reset Password</title>
</head>
<body style="margin:0;padding:20px;background-color:#ffffff;font-family:'Segoe UI',Arial,sans-serif;color:#111827;line-height:1.5;">
    <div style="max-width:600px;margin:0 auto;">
        <h1 style="margin:0 0 10px;font-size:22px;font-weight:700;">Reset Your Password</h1>
        <hr style="border:none;border-top:1px solid #d1d5db;margin:0 0 16px 0;" />

        <p style="margin:0 0 12px;font-size:15px;">Hello <strong>@Username</strong>,</p>
        <p style="margin:0 0 20px;font-size:15px;">Use the details below to reset your password.</p>

        <p style="margin:0 0 10px;font-size:15px;"><strong>Verification Code:</strong> <span style="font-family:Consolas,'Courier New',monospace;font-size:24px;font-weight:700;letter-spacing:2px;">@VerificationCode</span></p>
        <p style="margin:0 0 14px;font-size:15px;">This code expires in <strong>@OtpExpiryMinutes minutes</strong>.</p>

        <p style="margin:0 0 6px;font-size:15px;"><strong>Reference Code:</strong> <span style="font-family:Consolas,'Courier New',monospace;font-size:24px;font-weight:700;letter-spacing:2px;">@ReferenceCode</span></p>
        <p style="margin:0 0 12px;font-size:15px;color:#374151;">If you requested multiple codes, compare this Reference Code with the one shown on the verification screen, then use the matching Verification Code.</p>

        <p style="margin:0 0 6px;font-size:15px;"><strong>Temporary Password:</strong> <span style="font-family:Consolas,'Courier New',monospace;font-size:24px;font-weight:700;letter-spacing:1px;">@TempPassword</span></p>
        <p style="margin:0 0 12px;font-size:15px;color:#374151;">Use this password after verification to sign in.</p>

        <p style="margin:0 0 14px;font-size:15px;">&nbsp;</p>
        <p style="margin:0 0 6px;font-size:15px;"><strong>Next steps</strong></p>
        <p style="margin:0 0 4px;font-size:15px;">1) Enter the verification code.</p>
        <p style="margin:0 0 4px;font-size:15px;">2) Sign in with your username and temporary password.</p>
        <p style="margin:0 0 14px;font-size:15px;">3) Update your password after sign in.</p>

        <p style="margin:0 0 16px;font-size:15px;">If you did not request this, you can ignore this email.</p>

        <hr style="border:none;border-top:1px solid #d1d5db;margin:18px 0;" />

        <p style="margin:0 0 4px;font-size:14px;color:#4b5563;">POT</p>
        <p style="margin:0;font-size:14px;"><a href="https://payontime.com.au" style="color:#1d4ed8;">https://payontime.com.au</a></p>
    </div>
</body>

</html>

@code {
    [Parameter]
    public required string Username { get; set; }

    [Parameter]
    public required string ReferenceCode { get; set; }

    [Parameter]
    public required string VerificationCode { get; set; }

    [Parameter]
    public required string TempPassword { get; set; }

    [Parameter]
    public required int OtpExpiryMinutes { get; set; }
}