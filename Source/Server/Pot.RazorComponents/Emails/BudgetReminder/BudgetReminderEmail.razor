                    @if (UserIncomes.Count > 0)
                    {
                        <div style="margin-bottom:30px;">
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;">
                                <tr>
                                    <td style="background-color:#e8f5e9;padding:10px 20px 6px;border-radius:8px 8px 0 0;">
                                        <h3 style="color:#2e7d32;margin:0;font-size:16px;font-weight:700;">INCOMES (@UserIncomes.Count)</h3>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:0;">
