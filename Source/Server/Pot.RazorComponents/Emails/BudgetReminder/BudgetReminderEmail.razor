@using Pot.RazorComponents.Models

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>POT - Budget Reminder</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f6f9;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
    <center style="width:100%;background-color:#f4f6f9;padding:20px 0;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="width:600px;margin:0 auto;background:#ffffff;border-radius:8px;border:1px solid #e5e7eb;box-shadow:0 6px 18px rgba(0,0,0,0.06);overflow:hidden;">

            <!-- Header -->
            <tr>
                <td style="background:#4f46e5;padding:20px 24px;text-align:center;color:#ffffff;">
                    <h1 style="margin:0;font-size:20px;line-height:1.2;font-weight:700;">Budget Reminder</h1>
                    <p style="margin:6px 0 0;font-size:16px;opacity:0.95;">Your @ReminderDays-day financial overview</p>
                </td>
            </tr>

            <!-- Main Content -->
            <tr>
                <td style="padding:24px;">
                    <div style="margin-bottom:20px;">
                        <h2 style="color:#333;margin:0 0 8px 0;font-size:18px;">Hello @DisplayName,</h2>
                        <p style="color:#555;margin:0;font-size:14px;">Here are your upcoming incomes and expenses for the next @ReminderDays days.</p>
                    </div>

                    <!-- Incomes -->
                    @if (UserIncomes.Count > 0)
                    {
                        <div style="margin-bottom:30px;">
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;">
                                <tr>
                                    <td style="background-color:#f0f0f0;padding:10px 20px 6px;border-radius:8px 8px 0 0;">
                                        <h3 style="color:#333;margin:0;font-size:16px;font-weight:700;">INCOMES (@UserIncomes.Count)</h3>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:0;">
                                        <!--[if mso]>
                                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                                            <tr>
                                                <td>
                                        <![endif]-->
                                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;border-style:solid;border-color:#e0e0e0;border-width:0 1px 1px 1px;table-layout:fixed;mso-table-lspace:0pt;mso-table-rspace:0pt;">
                                            <colgroup>
                                                <col style="width:45%;" width="45%">
                                                <col style="width:20%;" width="20%">
                                                <col style="width:35%;" width="35%">
                                            </colgroup>
                                            <thead>
                                                <tr style="background-color:#424242;color:white;">
                                                    <th width="45%" style="padding:12px;text-align:left;border-bottom:2px solid #e0e0e0;width:45%;font-weight:600;font-size:13px;">Description</th>
                                                    <th width="20%" style="padding:12px;text-align:right;border-bottom:2px solid #e0e0e0;width:20%;font-weight:600;font-size:13px;">Amount</th>
                                                    <th width="35%" style="padding:12px;text-align:center;border-bottom:2px solid #e0e0e0;width:35%;font-weight:600;font-size:13px;">Due Date</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var (income, index) in UserIncomes.Select((i, idx) => (i, idx)))
                                                {
                                                    var bgColor = income.DaysDue < 0 ? "#fef2f2" : (index % 2 == 0 ? "#ffffff" : "#f5f5f5");
                                                    var (statusColor, statusText) = GetDueStatus(income.DaysDue);
                                                    <tr style="background-color:@bgColor;border-bottom:1px solid #e0e0e0;">
                                                        <td width="45%" style="padding:12px;width:45%;font-size:14px;">
                                                            <div style="margin:0;line-height:1.2;mso-line-height-rule:exactly;">@income.Description</div>
                                                        </td>
                                                        <td width="20%" style="padding:12px;text-align:right;width:20%;font-weight:bold;color:#333;font-size:14px;">
                                                            <div style="margin:0;line-height:1.2;mso-line-height-rule:exactly;">@CurrencySymbol@income.Amount.ToString("N2")</div>
                                                        </td>
                                                        <td width="35%" style="padding:12px;text-align:center;width:35%;font-size:13px;">
                                                            <div style="margin:0;line-height:1.2;mso-line-height-rule:exactly;color:@statusColor;font-weight:bold;">@statusText</div>
                                                            <div style="margin:0;line-height:1.2;mso-line-height-rule:exactly;color:#757575;font-size:12px;">@income.NextDue.ToString("ddd, dd MMM yyyy")</div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        <!--[if mso]>
                                                </td>
                                            </tr>
                                        </table>
                                        <![endif]-->
                                    </td>
                                </tr>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div style="margin-bottom:30px;">
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;">
                                <tr>
                                    <td style="background-color:#f0f0f0;padding:10px 20px 6px;border-radius:8px 8px 0 0;">
                                        <h3 style="color:#333;margin:0;font-size:16px;font-weight:700;">INCOMES (0)</h3>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:0;">
                                        <!--[if mso]>
                                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                                            <tr>
                                                <td>
                                        <![endif]-->
                                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;border-style:solid;border-color:#e0e0e0;border-width:0 1px 1px 1px;table-layout:fixed;mso-table-lspace:0pt;mso-table-rspace:0pt;">
                                            <colgroup>
                                                <col style="width:45%;" width="45%">
                                                <col style="width:20%;" width="20%">
                                                <col style="width:35%;" width="35%">
                                            </colgroup>
                                            <thead>
                                                <tr style="background-color:#424242;color:white;">
                                                    <th width="45%" style="padding:12px;text-align:left;border-bottom:2px solid #e0e0e0;width:45%;font-weight:600;font-size:13px;">Description</th>
                                                    <th width="20%" style="padding:12px;text-align:right;border-bottom:2px solid #e0e0e0;width:20%;font-weight:600;font-size:13px;">Amount</th>
                                                    <th width="35%" style="padding:12px;text-align:center;border-bottom:2px solid #e0e0e0;width:35%;font-weight:600;font-size:13px;">Due Date</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr style="background-color:#ffffff;border-bottom:1px solid #e0e0e0;">
                                                    <td colspan="3" style="padding:12px;color:#999;font-style:italic;font-size:14px;">
                                                        <div style="margin:0;line-height:1.2;mso-line-height-rule:exactly;">No upcoming incomes in the next @ReminderDays days.</div>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                        <!--[if mso]>
                                                </td>
                                            </tr>
                                        </table>
                                        <![endif]-->
                                    </td>
                                </tr>
                            </table>
                        </div>
                    }

                    <!-- Expenses -->
                    @if (UserExpenses.Count > 0)
                    {
                        <div style="margin-bottom:30px;">
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;">
                                <tr>
                                    <td style="background-color:#f0f0f0;padding:10px 20px 6px;border-radius:8px 8px 0 0;">
                                        <h3 style="color:#333;margin:0;font-size:16px;font-weight:700;">EXPENSES (@UserExpenses.Count)</h3>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:0;">
                                        <!--[if mso]>
                                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                                            <tr>
                                                <td>
                                        <![endif]-->
                                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;border-style:solid;border-color:#e0e0e0;border-width:0 1px 1px 1px;table-layout:fixed;mso-table-lspace:0pt;mso-table-rspace:0pt;">
                                            <colgroup>
                                                <col style="width:45%;" width="45%">
                                                <col style="width:20%;" width="20%">
                                                <col style="width:35%;" width="35%">
                                            </colgroup>
                                            <thead>
                                                <tr style="background-color:#424242;color:white;">
                                                    <th width="45%" style="padding:12px;text-align:left;border-bottom:2px solid #e0e0e0;width:45%;font-weight:600;font-size:13px;">Description</th>
                                                    <th width="20%" style="padding:12px;text-align:right;border-bottom:2px solid #e0e0e0;width:20%;font-weight:600;font-size:13px;">Amount</th>
                                                    <th width="35%" style="padding:12px;text-align:center;border-bottom:2px solid #e0e0e0;width:35%;font-weight:600;font-size:13px;">Due Date</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var (expense, index) in UserExpenses.Select((e, idx) => (e, idx)))
                                                {
                                                    var bgColor = expense.DaysDue < 0 ? "#fef2f2" : (index % 2 == 0 ? "#ffffff" : "#f5f5f5");
                                                    var (statusColor, statusText) = GetDueStatus(expense.DaysDue);
                                                    <tr style="background-color:@bgColor;border-bottom:1px solid #e0e0e0;">
                                                        <td width="45%" style="padding:12px;width:45%;font-size:14px;">
                                                            <div style="margin:0;line-height:1.2;mso-line-height-rule:exactly;">@expense.Description</div>
                                                        </td>
                                                        <td width="20%" style="padding:12px;text-align:right;width:20%;font-weight:bold;color:#333;font-size:14px;">
                                                            <div style="margin:0;line-height:1.2;mso-line-height-rule:exactly;">@CurrencySymbol@expense.Amount.ToString("N2")</div>
                                                        </td>
                                                        <td width="35%" style="padding:12px;text-align:center;width:35%;font-size:13px;">
                                                            <div style="margin:0;line-height:1.2;mso-line-height-rule:exactly;color:@statusColor;font-weight:bold;">@statusText</div>
                                                            <div style="margin:0;line-height:1.2;mso-line-height-rule:exactly;color:#757575;font-size:12px;">@expense.NextDue.ToString("ddd, dd MMM yyyy")</div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                        <!--[if mso]>
                                                </td>
                                            </tr>
                                        </table>
                                        <![endif]-->
                                    </td>
                                </tr>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div style="margin-bottom:30px;">
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;">
                                <tr>
                                    <td style="background-color:#f0f0f0;padding:10px 20px 6px;border-radius:8px 8px 0 0;">
                                        <h3 style="color:#333;margin:0;font-size:16px;font-weight:700;">EXPENSES (0)</h3>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:0;">
                                        <!--[if mso]>
                                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                                            <tr>
                                                <td>
                                        <![endif]-->
                                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;border-style:solid;border-color:#e0e0e0;border-width:0 1px 1px 1px;table-layout:fixed;mso-table-lspace:0pt;mso-table-rspace:0pt;">
                                            <colgroup>
                                                <col style="width:45%;" width="45%">
                                                <col style="width:20%;" width="20%">
                                                <col style="width:35%;" width="35%">
                                            </colgroup>
                                            <thead>
                                                <tr style="background-color:#424242;color:white;">
                                                    <th width="45%" style="padding:12px;text-align:left;border-bottom:2px solid #e0e0e0;width:45%;font-weight:600;font-size:13px;">Description</th>
                                                    <th width="20%" style="padding:12px;text-align:right;border-bottom:2px solid #e0e0e0;width:20%;font-weight:600;font-size:13px;">Amount</th>
                                                    <th width="35%" style="padding:12px;text-align:center;border-bottom:2px solid #e0e0e0;width:35%;font-weight:600;font-size:13px;">Due Date</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr style="background-color:#ffffff;border-bottom:1px solid #e0e0e0;">
                                                    <td colspan="3" style="padding:12px;color:#999;font-style:italic;font-size:14px;">
                                                        <div style="margin:0;line-height:1.2;mso-line-height-rule:exactly;">No upcoming expenses in the next @ReminderDays days.</div>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                        <!--[if mso]>
                                                </td>
                                            </tr>
                                        </table>
                                        <![endif]-->
                                    </td>
                                </tr>
                            </table>
                        </div>
                    }

                    <div style="margin-top:24px;padding-top:12px;border-top:1px solid #e5e7eb;">
                        <p style="color:#555;margin:0 0 4px;font-size:13px;">This reminder includes items due within the next @ReminderDays days.</p>
                        <p style="color:#999;font-size:12px;margin:0 0 2px;">Generated: @GeneratedDateTime.ToString("ddd, dd MMM yyyy, h:mm tt")</p>
                        <p style="color:#999;font-size:12px;margin:0;">Last logged in: @LastLoggedInUtc.ToString("ddd, dd MMM yyyy, h:mm tt")</p>
                    </div>
                </td>
            </tr>

            <!-- Footer -->
            <tr>
                <td style="padding:20px 24px;border-top:1px solid #e5e7eb;text-align:center;">
                    <p style="margin:0;font-size:13px;color:#4b5563;">POT</p>
                    <p style="margin:4px 0 0;font-size:13px;"><a href="https://payontime.com.au" style="color:#1d4ed8;">https://payontime.com.au</a></p>
                </td>
            </tr>

        </table>
    </center>
</body>
</html>

@code {
    [Parameter]
    public string CurrencySymbol { get; set; } = string.Empty;

    [Parameter]
    public int ReminderDays { get; set; }

    [Parameter]
    public string Username { get; set; } = string.Empty;

    [Parameter]
    public string DisplayName { get; set; } = string.Empty;

    [Parameter]
    public DateTime GeneratedDateTime { get; set; }

    [Parameter]
    public DateTime LastLoggedInUtc { get; set; }

    [Parameter]
    public IReadOnlyList<EmailBudgetReminderInfo.IncomeInfo> UserIncomes { get; set; } = [];

    [Parameter]
    public IReadOnlyList<EmailBudgetReminderInfo.ExpenseInfo> UserExpenses { get; set; } = [];

    private static (string color, string text) GetDueStatus(int daysDue)
    {
        if (daysDue < 0)
        {
            var absDays = Math.Abs(daysDue);
            return ("#d32f2f", $"{absDays} {(absDays == 1 ? "day" : "days")} overdue");
        }

        if (daysDue == 0)
        {
            return ("#f57c00", "Due today");
        }

        return ("#333333", $"In {daysDue} {(daysDue == 1 ? "day" : "days")}");
    }

}
