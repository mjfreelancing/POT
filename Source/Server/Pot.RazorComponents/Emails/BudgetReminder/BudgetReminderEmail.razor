@using Pot.RazorComponents.Models

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>POT - Budget Reminder</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f6f9;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
    <center style="width:100%;background-color:#f4f6f9;padding:20px 0;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="800" style="width:800px;margin:0 auto;background:#ffffff;border-radius:8px;border:1px solid #e5e7eb;box-shadow:0 6px 18px rgba(0,0,0,0.06);overflow:hidden;">

            <!-- Header -->
            <tr>
                <td style="background:#4f46e5;padding:20px 24px;text-align:center;color:#ffffff;">
                    <h1 style="margin:0;font-size:20px;line-height:1.2;font-weight:700;">Budget Reminder</h1>
                    <p style="margin:6px 0 0;font-size:16px;opacity:0.95;">Your @ReminderDays-day financial overview</p>
                </td>
            </tr>

            <!-- Main Content -->
            <tr>
                <td style="padding:24px;">
                    <div style="background-color:#f5f5f5;padding:20px;border-radius:8px;margin-bottom:20px;">
                        <h2 style="color:#333;margin:0 0 10px 0;font-size:18px;">Hello @DisplayName,</h2>
                        <p style="color:#666;margin:0 0 10px 0;font-size:14px;">Here are your upcoming incomes and expenses for the next @ReminderDays days.</p>
                        <p style="color:#999;font-size:13px;margin:0 0 4px 0;">Generated: @GeneratedDateTime.ToString("ddd, dd MMM yyyy, h:mm tt")</p>
                        <p style="color:#999;font-size:13px;margin:0;">Last logged in: @LastLoggedInUtc.ToString("ddd, dd MMM yyyy, h:mm tt")</p>
                    </div>

                    <!-- Incomes -->
                    @if (UserIncomes.Count > 0)
                    {
                        <div style="margin-bottom:30px;">
                            <div style="background-color:#e8f5e9;padding:12px 20px;border-radius:8px 8px 0 0;border-bottom:2px solid #2e7d32;">
                                <h3 style="color:#2e7d32;margin:0;font-size:16px;font-weight:700;">INCOMES (@UserIncomes.Count)</h3>
                            </div>
                            <table role="presentation" style="width:100%;border-collapse:collapse;border:1px solid #e0e0e0;border-top:none;">
                                <thead>
                                    <tr style="background-color:#424242;color:white;">
                                        <th style="padding:12px;text-align:left;border-bottom:2px solid #e0e0e0;font-weight:600;font-size:13px;">Description</th>
                                        <th style="padding:12px;text-align:right;border-bottom:2px solid #e0e0e0;width:120px;font-weight:600;font-size:13px;">Amount</th>
                                        <th style="padding:12px;text-align:center;border-bottom:2px solid #e0e0e0;width:150px;font-weight:600;font-size:13px;">Due Date</th>
                                        <th style="padding:12px;text-align:left;border-bottom:2px solid #e0e0e0;font-weight:600;font-size:13px;">Note</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var (income, index) in UserIncomes.Select((i, idx) => (i, idx)))
                                    {
                                        var bgColor = index % 2 == 0 ? "#ffffff" : "#f5f5f5";
                                        var (statusColor, statusText) = GetDueStatus(income.DaysDue);
                                        <tr style="background-color:@bgColor;">
                                            <td style="padding:12px;border-bottom:1px solid #e0e0e0;font-size:14px;">@income.Description</td>
                                            <td style="padding:12px;text-align:right;border-bottom:1px solid #e0e0e0;font-weight:bold;color:#2e7d32;font-size:14px;">@CurrencySymbol@income.Amount.ToString("N2")</td>
                                            <td style="padding:12px;text-align:center;border-bottom:1px solid #e0e0e0;font-size:13px;">
                                                <div style="color:@statusColor;font-weight:bold;margin-bottom:2px;">@statusText</div>
                                                <div style="color:#757575;font-size:12px;">@income.NextDue.ToString("ddd, dd MMM yyyy")</div>
                                            </td>
                                            <td style="padding:12px;border-bottom:1px solid #e0e0e0;color:#757575;font-style:italic;font-size:13px;">@(string.IsNullOrWhiteSpace(income.Note) ? "" : income.Note)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div style="margin-bottom:30px;padding:20px;background-color:#f9f9f9;border-radius:8px;border-left:4px solid #2e7d32;">
                            <p style="color:#666;margin:0;font-size:14px;"><strong>No upcoming incomes</strong> in the next @ReminderDays days.</p>
                        </div>
                    }

                    <!-- Expenses -->
                    @if (UserExpenses.Count > 0)
                    {
                        <div style="margin-bottom:30px;">
                            <div style="background-color:#ffebee;padding:12px 20px;border-radius:8px 8px 0 0;border-bottom:2px solid #c62828;">
                                <h3 style="color:#c62828;margin:0;font-size:16px;font-weight:700;">EXPENSES (@UserExpenses.Count)</h3>
                            </div>
                            <table role="presentation" style="width:100%;border-collapse:collapse;border:1px solid #e0e0e0;border-top:none;">
                                <thead>
                                    <tr style="background-color:#424242;color:white;">
                                        <th style="padding:12px;text-align:left;border-bottom:2px solid #e0e0e0;font-weight:600;font-size:13px;">Description</th>
                                        <th style="padding:12px;text-align:right;border-bottom:2px solid #e0e0e0;width:120px;font-weight:600;font-size:13px;">Amount</th>
                                        <th style="padding:12px;text-align:center;border-bottom:2px solid #e0e0e0;width:150px;font-weight:600;font-size:13px;">Due Date</th>
                                        <th style="padding:12px;text-align:left;border-bottom:2px solid #e0e0e0;font-weight:600;font-size:13px;">Note</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var (expense, index) in UserExpenses.Select((e, idx) => (e, idx)))
                                    {
                                        var bgColor = index % 2 == 0 ? "#ffffff" : "#f5f5f5";
                                        var (statusColor, statusText) = GetDueStatus(expense.DaysDue);
                                        <tr style="background-color:@bgColor;">
                                            <td style="padding:12px;border-bottom:1px solid #e0e0e0;font-size:14px;">@expense.Description</td>
                                            <td style="padding:12px;text-align:right;border-bottom:1px solid #e0e0e0;font-weight:bold;color:#c62828;font-size:14px;">@CurrencySymbol@expense.Amount.ToString("N2")</td>
                                            <td style="padding:12px;text-align:center;border-bottom:1px solid #e0e0e0;font-size:13px;">
                                                <div style="color:@statusColor;font-weight:bold;margin-bottom:2px;">@statusText</div>
                                                <div style="color:#757575;font-size:12px;">@expense.NextDue.ToString("ddd, dd MMM yyyy")</div>
                                            </td>
                                            <td style="padding:12px;border-bottom:1px solid #e0e0e0;color:#757575;font-style:italic;font-size:13px;">@(string.IsNullOrWhiteSpace(expense.Note) ? "" : expense.Note)</td>
                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div style="margin-bottom:30px;padding:20px;background-color:#f9f9f9;border-radius:8px;border-left:4px solid #c62828;">
                            <p style="color:#666;margin:0;font-size:14px;"><strong>No upcoming expenses</strong> in the next @ReminderDays days.</p>
                        </div>
                    }

                    <div style="margin-top:30px;padding:15px;background-color:#f5f5f5;border-radius:8px;text-align:center;">
                        <p style="color:#666;margin:0;font-size:13px;">This reminder includes items due within the next @ReminderDays days.</p>
                    </div>
                </td>
            </tr>

            <!-- Footer -->
            <tr>
                <td style="background:#f9fafb;padding:20px 24px;text-align:center;border-top:1px solid #e5e7eb;">
                    <p style="margin:0;font-size:12px;color:#6b7280;">
                        Questions or need help?<br/>
                        Visit <a href="https://payontime.com.au" style="color:#4f46e5;text-decoration:none;">payontime.com.au</a> for support
                    </p>
                    <p style="margin:10px 0 0;font-size:11px;color:#9ca3af;">
                        © POT - Pay On Time
                    </p>
                </td>
            </tr>

        </table>
    </center>
</body>
</html>

@code {
    [Parameter]
    public string CurrencySymbol { get; set; } = string.Empty;

    [Parameter]
    public int ReminderDays { get; set; }

    [Parameter]
    public string Username { get; set; } = string.Empty;

    [Parameter]
    public string DisplayName { get; set; } = string.Empty;

    [Parameter]
    public DateTime GeneratedDateTime { get; set; }

    [Parameter]
    public DateTime LastLoggedInUtc { get; set; }

    [Parameter]
    public IReadOnlyList<EmailBudgetReminderInfo.IncomeInfo> UserIncomes { get; set; } = [];

    [Parameter]
    public IReadOnlyList<EmailBudgetReminderInfo.ExpenseInfo> UserExpenses { get; set; } = [];

    private static (string color, string text) GetDueStatus(int daysDue)
    {
        if (daysDue < 0)
        {
            var absDays = Math.Abs(daysDue);
            return ("#d32f2f", $"{absDays} {(absDays == 1 ? "day" : "days")} overdue");
        }

        if (daysDue == 0)
        {
            return ("#f57c00", "Due today");
        }

        return ("#333333", $"In {daysDue} {(daysDue == 1 ? "day" : "days")}");
    }
}
