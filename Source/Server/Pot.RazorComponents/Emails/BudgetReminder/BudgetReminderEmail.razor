@code {
    private const string ZeroWidthSpaceEntity = "&#8203;";

    [Parameter]
    public string CurrencySymbol { get; set; } = string.Empty;

    [Parameter]
    public int ReminderDays { get; set; }

    [Parameter]
    public string Username { get; set; } = string.Empty;

    [Parameter]
    public string DisplayName { get; set; } = string.Empty;

    [Parameter]
    public DateTime GeneratedDateTime { get; set; }

    [Parameter]
    public DateTime LastLoggedInUtc { get; set; }

    [Parameter]
    public IReadOnlyList<EmailBudgetReminderInfo.IncomeInfo> UserIncomes { get; set; } = [];

    [Parameter]
    public IReadOnlyList<EmailBudgetReminderInfo.ExpenseInfo> UserExpenses { get; set; } = [];

    private static (string color, string text) GetDueStatus(int daysDue)
    {
        if (daysDue < 0)
        {
            var absDays = Math.Abs(daysDue);
            return ("#d32f2f", $"{absDays} {(absDays == 1 ? "day" : "days")} overdue");
        }

        if (daysDue == 0)
        {
            return ("#f57c00", "Due today");
        }

        return ("#333333", $"In {daysDue} {(daysDue == 1 ? "day" : "days")}");
    }

    // Insert soft break opportunities for long tokens (e.g., URLs) while preserving HTML encoding.
    private static MarkupString RenderNote(string? note)
    {
        if (string.IsNullOrWhiteSpace(note))
        {
            return new MarkupString(string.Empty);
        }

        return new MarkupString(InsertSoftBreaks(note));
    }

    // Splits long tokens and injects zero-width spaces to help Outlook/Gmail wrap lines.
    private static string InsertSoftBreaks(string value)
    {
        // Only chunk tokens longer than this to avoid adding extra break points in normal
        // words or short phrases; 40 keeps typical text intact while targeting URLs.
        const int tokenThreshold = 40;

        // Chunk size for long tokens; 30 keeps chunks small enough to wrap
        // in narrow email columns without making the text look overly segmented.
        const int breakInterval = 30;

        // Split on spaces so only long unbroken tokens get chunked.
        var tokens = value.Split(' ');

        // Pre-size for a rough upper bound of extra characters from inserted entities:
        // value.Length / breakInterval estimates how many chunk boundaries we may insert,
        // and each "&#8203;" entity adds 6 characters, so we use 5 as a conservative
        // multiplier to reduce reallocations without over-allocating too much.
        var builder = new StringBuilder(value.Length + (value.Length / breakInterval) * 5);

        for (var i = 0; i < tokens.Length; i++)
        {
            if (i > 0)
            {
                builder.Append(' ');
            }

            var token = tokens[i];

            // Encode and append short tokens as-is.
            if (token.Length <= tokenThreshold)
            {
                builder.Append(WebUtility.HtmlEncode(token));
                continue;
            }

            var startIndex = 0;

            // Chunk long tokens and inject zero-width spaces between chunks.
            while (startIndex < token.Length)
            {
                var remaining = token.Length - startIndex;

                var take = remaining > breakInterval
                    ? breakInterval
                    : remaining;

                var chunk = token.Substring(startIndex, take);

                builder.Append(WebUtility.HtmlEncode(chunk));

                startIndex += take;

                if (startIndex < token.Length)
                {
                    builder.Append(ZeroWidthSpaceEntity);
                }
            }
        }

        return builder.ToString();
    }
}
