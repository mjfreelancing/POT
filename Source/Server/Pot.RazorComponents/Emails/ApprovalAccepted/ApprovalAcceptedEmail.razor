@using Models

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>POT - Account Approved</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f6f9;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
    <center style="width:100%;background-color:#f4f6f9;padding:20px 0;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="width:600px;margin:0 auto;background:#ffffff;border-radius:8px;border:1px solid #e5e7eb;box-shadow:0 6px 18px rgba(0,0,0,0.06);overflow:hidden;">

            <!-- Header -->
            <tr>
                <td style="background:#4f46e5;padding:20px 24px;text-align:center;color:#ffffff;">
                    <h1 style="margin:0;font-size:20px;line-height:1.2;font-weight:700;">Account Approved</h1>
                    <p style="margin:6px 0 0;font-size:16px;opacity:0.95;">You can now sign in</p>
                </td>
            </tr>

            <!-- Main Content -->
            <tr>
                <td style="padding:24px;">
                    <div style="margin-bottom:20px;">
                        <h2 style="color:#333;margin:0 0 8px 0;font-size:18px;">Hello @Username,</h2>
                        <p style="color:#555;margin:0;font-size:14px;">Great news. Your account has been approved and you can now sign in.</p>
                    </div>

                    <!-- Sign-in Details -->
                    <div style="margin-bottom:20px;">
                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;">
                            <tr>
                                <td style="background-color:#f0f0f0;padding:10px 20px 6px;border-radius:8px 8px 0 0;">
                                    <h3 style="color:#333;margin:0;font-size:16px;font-weight:700;">SIGN-IN DETAILS</h3>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:0;">
                                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-collapse:collapse;border-style:solid;border-color:#e0e0e0;border-width:0 1px 1px 1px;table-layout:fixed;mso-table-lspace:0pt;mso-table-rspace:0pt;">
                                        <colgroup>
                                            <col style="width:30%;" width="30%">
                                            <col style="width:70%;" width="70%">
                                        </colgroup>
                                        <tbody>
                                            <tr style="background-color:#ffffff;border-bottom:1px solid #e0e0e0;">
                                                <td width="30%" style="padding:12px;width:30%;font-size:13px;font-weight:600;color:#757575;">Username</td>
                                                <td width="70%" style="padding:12px;width:70%;color:#333;">
                                                    <div style="font-family:Consolas,'Courier New',monospace;font-size:18px;font-weight:700;">@Username</div>
                                                </td>
                                            </tr>
                                            <tr style="background-color:#f5f5f5;">
                                                <td width="30%" style="padding:12px;width:30%;font-size:13px;font-weight:600;color:#757575;">Password</td>
                                                <td width="70%" style="padding:12px;width:70%;font-size:14px;color:#333;">Use the temporary password from your original verification email.</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Next Steps -->
                    <div>
                        <h3 style="color:#333;margin:0 0 8px 0;font-size:16px;font-weight:700;">Next steps</h3>
                        <ol style="color:#555;margin:0;padding-left:20px;font-size:14px;">
                            <li style="margin-bottom:4px;">Sign in at <a href="https://payontime.com.au/login" style="color:#1d4ed8;">https://payontime.com.au/login</a>.</li>
                            <li style="margin-bottom:4px;">Use your username and temporary password.</li>
                            <li>Change your password after sign in.</li>
                        </ol>
                    </div>
                </td>
            </tr>

            <!-- Footer -->
            <tr>
                <td style="padding:20px 24px;border-top:1px solid #e5e7eb;text-align:center;">
                    <p style="margin:0;font-size:13px;color:#4b5563;">POT</p>
                    <p style="margin:4px 0 0;font-size:13px;"><a href="https://payontime.com.au" style="color:#1d4ed8;">https://payontime.com.au</a></p>
                </td>
            </tr>

        </table>
    </center>
</body>
</html>

@code {
    [Parameter]
    public required string Username { get; set; }
}
