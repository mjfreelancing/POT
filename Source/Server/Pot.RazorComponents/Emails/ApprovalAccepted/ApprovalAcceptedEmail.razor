@using Models

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Account Approved - Welcome to POT</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f6f9;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
    <center style="width:100%;background-color:#f4f6f9;padding:20px 0;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="width:600px;margin:0 auto;background:#ffffff;border-radius:8px;border:1px solid #e5e7eb;box-shadow:0 6px 18px rgba(0,0,0,0.06);overflow:hidden;">
            
            <!-- Header -->
            <tr>
                <td style="background:#10b981;padding:20px 24px;text-align:center;color:#ffffff;">
                    <h1 style="margin:0;font-size:20px;line-height:1.2;font-weight:700;">✓ Account Approved</h1>
                    <p style="margin:6px 0 0;font-size:16px;opacity:0.95;">Welcome to POT - Pay On Time</p>
                </td>
            </tr>

            <!-- Body -->
            <tr>
                <td bgcolor="#FFFFFF" style="padding:22px 24px 20px 24px;color:#111827;background:#FFFFFF;">
                    <p style="margin:0 0 6px;font-size:15px;font-weight:600;">Hello <strong style="color:#10b981;">@Username</strong>,</p>
                    <p style="margin:0 0 16px;color:#6b7280;font-size:14px;line-height:1.5;">Great news! Your account has been approved by a platform administrator. You can now access POT and start managing your finances.</p>

                    <!-- Account Details -->
                    <div style="background:#f0fdf4;border:1px solid #86efac;border-radius:8px;padding:16px;margin:8px 0 16px 0;">
                        <div style="color:#111827;font-size:14px;font-weight:700;margin:0 0 12px 0;">Your Account Information</div>
                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                            <tr>
                                <td style="padding:4px 0;color:#6b7280;font-size:13px;font-weight:600;width:160px;">Username:</td>
                                <td style="padding:4px 0;color:#111827;font-size:13px;font-family:SFMono-Regular,Menlo,Monaco,Consolas,'Courier New',monospace;">@Username</td>
                            </tr>
                            <tr>
                                <td style="padding:4px 0;color:#6b7280;font-size:13px;font-weight:600;vertical-align:top;">Password:</td>
                                <td style="padding:4px 0;color:#6b7280;font-size:13px;line-height:1.5;">Use the temporary password from your original verification email</td>
                            </tr>
                        </table>
                    </div>

                    <!-- Next Steps -->
                    <div style="margin:16px 0;">
                        <div style="color:#111827;font-size:14px;font-weight:700;margin:0 0 8px 0;">Next Steps:</div>
                        <ol style="margin:0;padding-left:20px;color:#6b7280;font-size:14px;line-height:1.8;">
                            <li>Click the button below to log in to POT</li>
                            <li>Use your username and the temporary password from your verification email</li>
                            <li>Go to <strong style="color:#111827;">Settings → Change Password</strong> to set your preferred password</li>
                            <li>Complete your profile and start managing your finances</li>
                        </ol>
                    </div>

                    <!-- Action Button -->
                    <div style="text-align:center;margin:24px 0;">
                        <a href="https://payontime.com.au/login" style="display:inline-block;background:#10b981;color:#ffffff;text-decoration:none;padding:12px 32px;border-radius:6px;font-size:14px;font-weight:600;letter-spacing:0.3px;">Log In to POT</a>
                    </div>

                    <!-- Security Notice -->
                    <div style="border:1px solid #fde68a;border-radius:6px;padding:12px 16px;margin-top:16px;background:#fffbeb;">
                        <div style="color:#92400e;font-size:13px;font-weight:700;margin:0 0 6px 0;">🔒 Security Reminder</div>
                        <div style="color:#92400e;font-size:13px;line-height:1.5;">Please change your temporary password immediately after your first login.</div>
                        <div style="color:#92400e;font-size:13px;line-height:1.5;margin-top:4px;">Do not share your credentials with anyone.</div>
                    </div>
                </td>
            </tr>

            <!-- Footer -->
            <tr>
                <td style="background:#f9fafb;padding:16px 24px;color:#6b7280;font-size:12px;text-align:center;line-height:1.5;">
                    <div style="margin-bottom:4px;color:#374151;">This is an automated notification from POT.</div>
                    <div style="margin-bottom:4px;color:#374151;">Please do not reply to this email.</div>
                    <div style="padding-top:10px;border-top:1px solid #e5e7eb;">
                        <div style="color:#4f46e5;font-weight:700;font-size:13px;margin-bottom:4px;">POT - Pay On Time</div>
                        <div style="font-size:11px;"><a href="https://payontime.com.au" style="color:#4f46e5;text-decoration:none;">https://payontime.com.au</a></div>
                    </div>
                </td>
            </tr>
        </table>
    </center>
</body>

</html>

@code {
    [Parameter]
    public required string Username { get; set; }
}