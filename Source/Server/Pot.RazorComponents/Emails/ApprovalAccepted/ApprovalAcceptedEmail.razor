@using Models

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>POT - Account Approved</title>
</head>
<body style="margin:0;padding:20px;background-color:#ffffff;font-family:'Segoe UI',Arial,sans-serif;color:#111827;line-height:1.5;">
    <div style="max-width:600px;margin:0 auto;">
        <h1 style="margin:0 0 10px;font-size:22px;font-weight:700;">Account Approved</h1>
        <hr style="border:none;border-top:1px solid #d1d5db;margin:0 0 16px 0;" />

        <p style="margin:0 0 12px;font-size:15px;">Hello <strong>@Username</strong>,</p>
        <p style="margin:0 0 20px;font-size:15px;">Great news. Your account has been approved and you can now sign in.</p>

        <p style="margin:0 0 10px;font-size:15px;"><strong>Username:</strong> @Username</p>
        <p style="margin:0 0 14px;font-size:15px;"><strong>Password:</strong> Use the temporary password from your original verification email.</p>

        <p style="margin:0 0 14px;font-size:15px;">&nbsp;</p>
        <p style="margin:0 0 6px;font-size:15px;"><strong>Next steps</strong></p>
        <p style="margin:0 0 4px;font-size:15px;">1) Sign in at <a href="https://payontime.com.au/login" style="color:#1d4ed8;">https://payontime.com.au/login</a>.</p>
        <p style="margin:0 0 4px;font-size:15px;">2) Use your username and temporary password.</p>
        <p style="margin:0 0 14px;font-size:15px;">3) Change your password after sign in.</p>

        <hr style="border:none;border-top:1px solid #d1d5db;margin:18px 0;" />

        <p style="margin:0 0 4px;font-size:14px;color:#4b5563;">POT</p>
        <p style="margin:0;font-size:14px;"><a href="https://payontime.com.au" style="color:#1d4ed8;">https://payontime.com.au</a></p>
    </div>
</body>

</html>

@code {
    [Parameter]
    public required string Username { get; set; }
}