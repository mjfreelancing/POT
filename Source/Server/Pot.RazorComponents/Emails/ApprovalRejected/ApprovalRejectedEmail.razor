@using Models

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Account Application Update</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f6f9;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
    <center style="width:100%;background-color:#f4f6f9;padding:20px 0;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="width:600px;margin:0 auto;background:#ffffff;border-radius:8px;border:1px solid #e5e7eb;box-shadow:0 6px 18px rgba(0,0,0,0.06);overflow:hidden;">
            
            <!-- Header -->
            <tr>
                <td style="background:#6b7280;padding:20px 24px;text-align:center;color:#ffffff;">
                    <h1 style="margin:0;font-size:20px;line-height:1.2;font-weight:700;">Account Application Update</h1>
                    <p style="margin:6px 0 0;font-size:16px;opacity:0.95;">Regarding your POT account request</p>
                </td>
            </tr>

            <!-- Body -->
            <tr>
                <td bgcolor="#FFFFFF" style="padding:22px 24px 20px 24px;color:#111827;background:#FFFFFF;">
                    <p style="margin:0 0 6px;font-size:15px;font-weight:600;">Hello <strong style="color:#6b7280;">@Username</strong>,</p>
                    <p style="margin:0 0 16px;color:#6b7280;font-size:14px;line-height:1.5;">Thank you for your interest in POT - Pay On Time. After reviewing your account application, we are unable to approve your request at this time.</p>

                    <!-- Information Box -->
                    <div style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:16px;margin:16px 0;">
                        <div style="color:#111827;font-size:14px;font-weight:700;margin:0 0 8px 0;">What This Means</div>
                        <div style="color:#6b7280;font-size:14px;line-height:1.6;">
                            Your account will not be activated, and you will not be able to log in to POT. The username you registered with has been reserved and is no longer available for future registrations.
                        </div>
                    </div>

                    <!-- Contact Information -->
                    <div style="margin:20px 0 16px 0;">
                        <div style="color:#111827;font-size:14px;font-weight:700;margin:0 0 8px 0;">Questions or Concerns?</div>
                        <div style="color:#6b7280;font-size:14px;line-height:1.6;">
                            If you believe this decision was made in error or if you have questions about this outcome, please contact our support team for assistance.
                        </div>
                    </div>

                    <!-- Notice -->
                    <div style="border:1px solid #d1d5db;border-radius:6px;padding:12px 16px;margin-top:16px;background:#f9fafb;">
                        <div style="color:#374151;font-size:13px;line-height:1.5;">This decision is final. Please do not attempt to create a new account with the same username, as it is no longer available.</div>
                    </div>
                </td>
            </tr>

            <!-- Footer -->
            <tr>
                <td style="background:#f9fafb;padding:16px 24px;color:#6b7280;font-size:12px;text-align:center;line-height:1.5;">
                    <div style="margin-bottom:4px;color:#374151;">This is an automated notification from POT.</div>
                    <div style="margin-bottom:4px;color:#374151;">Please do not reply to this email.</div>
                    <div style="padding-top:10px;border-top:1px solid #e5e7eb;">
                        <div style="color:#4f46e5;font-weight:700;font-size:13px;margin-bottom:4px;">POT - Pay On Time</div>
                        <div style="font-size:11px;"><a href="https://payontime.com.au" style="color:#4f46e5;text-decoration:none;">https://payontime.com.au</a></div>
                    </div>
                </td>
            </tr>
        </table>
    </center>
</body>

</html>

@code {
    [Parameter]
    public required string Username { get; set; }
}