@using Models

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>POT - Account Application Update</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f6f9;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
    <center style="width:100%;background-color:#f4f6f9;padding:20px 0;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="width:600px;margin:0 auto;background:#ffffff;border-radius:8px;border:1px solid #e5e7eb;box-shadow:0 6px 18px rgba(0,0,0,0.06);overflow:hidden;">

            <!-- Header -->
            <tr>
                <td style="background:#4f46e5;padding:20px 24px;text-align:center;color:#ffffff;">
                    <h1 style="margin:0;font-size:20px;line-height:1.2;font-weight:700;">Account Application Update</h1>
                    <p style="margin:6px 0 0;font-size:16px;opacity:0.95;">The outcome of your application</p>
                </td>
            </tr>

            <!-- Main Content -->
            <tr>
                <td style="padding:24px;">
                    <div style="margin-bottom:20px;">
                        <h2 style="color:#333;margin:0 0 8px 0;font-size:18px;">Hello @DisplayName,</h2>
                        <p style="color:#555;margin:0;font-size:14px;">Thank you for your interest in POT. After reviewing your account application, we are unable to approve your request at this time.</p>
                    </div>

                    <div style="margin-bottom:20px;">
                        <h3 style="color:#333;margin:0 0 8px 0;font-size:16px;font-weight:700;">What this means</h3>
                        <p style="color:#555;margin:0;font-size:14px;">Your account will not be activated and you will not be able to sign in. The username you registered has been reserved and is no longer available for future registrations.</p>
                    </div>

                    <div>
                        <h3 style="color:#333;margin:0 0 8px 0;font-size:16px;font-weight:700;">Questions</h3>
                        <p style="color:#555;margin:0;font-size:14px;">If you believe this decision was made in error, please contact support for assistance.</p>
                    </div>
                </td>
            </tr>

            <!-- Footer -->
            <tr>
                <td style="padding:20px 24px;border-top:1px solid #e5e7eb;text-align:center;">
                    <p style="margin:0;font-size:13px;color:#4b5563;">POT</p>
                    <p style="margin:4px 0 0;font-size:13px;"><a href="https://payontime.com.au" style="color:#1d4ed8;">https://payontime.com.au</a></p>
                </td>
            </tr>

        </table>
    </center>
</body>
</html>

@code {
    [Parameter]
    public required string Username { get; set; }

    [Parameter]
    public required string DisplayName { get; set; }
}
