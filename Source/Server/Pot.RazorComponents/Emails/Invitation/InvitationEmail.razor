@using Models

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>You've been invited to POT</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f6f9;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
    <center style="width:100%;background-color:#f4f6f9;padding:20px 0;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="width:600px;margin:0 auto;background:#ffffff;border-radius:8px;border:1px solid #e5e7eb;box-shadow:0 6px 18px rgba(0,0,0,0.06);overflow:hidden;">
            
            <!-- Header -->
            <tr>
                <td style="background:#4f46e5;padding:20px 24px;text-align:center;color:#ffffff;">
                    <h1 style="margin:0;font-size:20px;line-height:1.2;font-weight:700;">You've been invited to POT</h1>
                    <p style="margin:6px 0 0;font-size:16px;opacity:0.95;">Your account has been created</p>
                </td>
            </tr>

            <!-- Body -->
            <tr>
                <td bgcolor="#FFFFFF" style="padding:22px 24px 20px 24px;color:#111827;background:#FFFFFF;">
                    <p style="margin:0 0 6px;font-size:15px;font-weight:600;">Hello <strong style="color:#4f46e5;">@Username</strong>,</p>
                    <p style="margin:0 0 16px;color:#6b7280;font-size:14px;line-height:1.5;">You've been invited to join POT! Your account has been created and you can log in using the temporary password below. After logging in, you'll be able to change your password.</p>

                    <!-- Temporary Password -->
                    <div style="background:#F3F8FF;border:1px solid #93C5FD;border-radius:8px;padding:14px 16px;margin:8px 0 0 0;">
                        <div style="color:#1D4ED8;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;margin:0 0 8px 0;">Temporary Password</div>
                        <div style="text-align:center;margin:0 0 8px 0;">
                            <div style="display:inline-block;background:#1F2937;border:1px solid #1F2937;border-radius:6px;padding:12px 20px;font-family:SFMono-Regular,Menlo,Monaco,Consolas,'Courier New',monospace;font-size:26px;font-weight:800;letter-spacing:5px;color:#E0E7FF;">@TempPassword</div>
                        </div>
                        <div style="color:#1F2937;font-size:12px;text-align:center;line-height:1.3;">Use this password to log in</div>
                    </div>

                    <!-- Instructions -->
                    <div style="margin-top:10px;padding:12px 0 20px 0;">
                        <div style="color:#111827;font-size:14px;font-weight:700;margin:0 0 4px 0;">How to get started</div>
                        <div style="border-top:2px solid #60A5FA;width:100%;height:0;margin:0 0 10px 0;"></div>
                        <ol style="margin:0 0 0 18px;padding:0;color:#374151;font-size:13px;line-height:1.5;">
                            <li style="margin-bottom:6px;">Go to POT at <a href="https://payontime.com.au/login" style="color:#4f46e5;text-decoration:none;font-weight:600;">https://payontime.com.au/login</a> and log in with your username and the <strong style="color:#111827;">Temporary Password</strong> above</li>
                            <li style="margin-bottom:6px;">Go to <strong style="color:#111827;">Settings</strong> to change your password</li>
                        </ol>
                    </div>

                    <!-- Security Notice -->
                    <div style="border:1px solid #FBBF24;border-radius:6px;padding:12px 16px;margin-top:12px;">
                        <div style="color:#FBBF24;font-size:13px;font-weight:700;margin:0 0 6px 0;">⚠️ Security Notice</div>
                        <ul style="margin:0 0 0 18px;padding:0;color:#6b7280;font-size:12px;line-height:1.5;">
                            <li style="margin-bottom:5px;">The temporary password is valid only until you set a new permanent password</li>
                            <li style="margin-bottom:5px;">If you didn't create this account, you can safely ignore this email</li>
                        </ul>
                    </div>
                </td>
            </tr>

            <!-- Footer -->
            <tr>
                <td style="background:#f9fafb;padding:16px 24px;color:#6b7280;font-size:12px;text-align:center;line-height:1.5;">
                    <div style="margin-bottom:4px;color:#374151;">This is an automated message from POT.</div>
                    <div style="margin-bottom:4px;color:#374151;">Please do not reply to this email.</div>
                    <div style="font-size:11px;color:#9ca3af;margin-bottom:10px;">If you continue to have issues, please contact support.</div>
                    <div style="padding-top:10px;border-top:1px solid #e5e7eb;">
                        <div style="color:#4f46e5;font-weight:700;font-size:13px;margin-bottom:4px;">POT - Pay On Time</div>
                        <div style="font-size:11px;"><a href="https://payontime.com.au" style="color:#4f46e5;text-decoration:none;">https://payontime.com.au</a></div>
                    </div>
                </td>
            </tr>
        </table>
    </center>
</body>

</html>

@code {
    [Parameter]
    public required string Username { get; set; }

    [Parameter]
    public required string TempPassword { get; set; }
}
