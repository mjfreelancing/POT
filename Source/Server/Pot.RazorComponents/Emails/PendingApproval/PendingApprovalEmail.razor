@using Models

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>POT - New User Pending Approval</title>
</head>
<body style="margin:0;padding:20px;background-color:#ffffff;font-family:'Segoe UI',Arial,sans-serif;color:#111827;line-height:1.5;">
    <div style="max-width:600px;margin:0 auto;">
        <h1 style="margin:0 0 10px;font-size:22px;font-weight:700;">New User Pending Approval</h1>
        <hr style="border:none;border-top:1px solid #d1d5db;margin:0 0 16px 0;" />

        <p style="margin:0 0 12px;font-size:15px;">Hello <strong>@Username</strong>,</p>
        <p style="margin:0 0 20px;font-size:15px;">A new user has signed up and is waiting for approval to access the platform.</p>

        <p style="margin:0 0 6px;font-size:15px;"><strong>Username:</strong> @UserUsername</p>
        <p style="margin:0 0 12px;font-size:15px;"><strong>Email:</strong> @UserEmail</p>

        <p style="margin:0 0 6px;font-size:15px;"><strong>Review pending approvals:</strong></p>
        <p style="margin:0 0 14px;font-size:15px;"><a href="https://payontime.com.au/approvals/pending" style="color:#1d4ed8;">https://payontime.com.au/approvals/pending</a></p>

        <p style="margin:0 0 16px;font-size:15px;color:#374151;">The user will receive an email notification when their account has been approved. Until then, they will see a pending approval message when attempting to sign in.</p>

        <hr style="border:none;border-top:1px solid #d1d5db;margin:18px 0;" />

        <p style="margin:0 0 4px;font-size:14px;color:#4b5563;">POT</p>
        <p style="margin:0;font-size:14px;"><a href="https://payontime.com.au" style="color:#1d4ed8;">https://payontime.com.au</a></p>
    </div>
</body>

</html>

@code {
    [Parameter]
    public required string Username { get; set; }

    [Parameter]
    public required string UserUsername { get; set; }

    [Parameter]
    public required string UserEmail { get; set; }
}