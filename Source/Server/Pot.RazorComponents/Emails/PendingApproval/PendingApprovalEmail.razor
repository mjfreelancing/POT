@using Models

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>New User Pending Approval</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f6f9;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
    <center style="width:100%;background-color:#f4f6f9;padding:20px 0;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="width:600px;margin:0 auto;background:#ffffff;border-radius:8px;border:1px solid #e5e7eb;box-shadow:0 6px 18px rgba(0,0,0,0.06);overflow:hidden;">
            
            <!-- Header -->
            <tr>
                <td style="background:#4f46e5;padding:20px 24px;text-align:center;color:#ffffff;">
                    <h1 style="margin:0;font-size:20px;line-height:1.2;font-weight:700;">New User Signup</h1>
                    <p style="margin:6px 0 0;font-size:16px;opacity:0.95;">A new user is pending approval</p>
                </td>
            </tr>

            <!-- Body -->
            <tr>
                <td bgcolor="#FFFFFF" style="padding:22px 24px 20px 24px;color:#111827;background:#FFFFFF;">
                    <p style="margin:0 0 6px;font-size:15px;font-weight:600;">Hello <strong style="color:#4f46e5;">@Username</strong>,</p>
                    <p style="margin:0 0 16px;color:#6b7280;font-size:14px;line-height:1.5;">A new user has signed up and is waiting for approval to access the platform.</p>

                    <!-- User Details -->
                    <div style="background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:16px;margin:8px 0 16px 0;">
                        <div style="color:#111827;font-size:14px;font-weight:700;margin:0 0 12px 0;">User Details</div>
                        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                            <tr>
                                <td style="padding:4px 0;color:#6b7280;font-size:13px;font-weight:600;width:100px;">Username:</td>
                                <td style="padding:4px 0;color:#111827;font-size:13px;font-family:SFMono-Regular,Menlo,Monaco,Consolas,'Courier New',monospace;">@UserUsername</td>
                            </tr>
                            <tr>
                                <td style="padding:4px 0;color:#6b7280;font-size:13px;font-weight:600;">Email:</td>
                                <td style="padding:4px 0;color:#111827;font-size:13px;font-family:SFMono-Regular,Menlo,Monaco,Consolas,'Courier New',monospace;">@UserEmail</td>
                            </tr>
                        </table>
                    </div>

                    <!-- Action Button -->
                    <div style="text-align:center;margin:20px 0;">
                        <a href="https://payontime.com.au/approvals/pending" style="display:inline-block;background:#4f46e5;color:#ffffff;text-decoration:none;padding:12px 32px;border-radius:6px;font-size:14px;font-weight:600;letter-spacing:0.3px;">Review Pending Approvals</a>
                    </div>

                    <!-- Notice -->
                    <div style="border:1px solid #93C5FD;border-radius:6px;padding:12px 16px;margin-top:16px;background:#F3F8FF;">
                        <div style="color:#1D4ED8;font-size:13px;font-weight:700;margin:0 0 6px 0;">ℹ️ NOTE: The user will receive an email notification when their account has been approved. Until then, they will see a pending approval message when attempting to login.</div>
                    </div>
                </td>
            </tr>

            <!-- Footer -->
            <tr>
                <td style="background:#f9fafb;padding:16px 24px;color:#6b7280;font-size:12px;text-align:center;line-height:1.5;">
                    <div style="margin-bottom:4px;color:#374151;">This is an automated notification from POT.</div>
                    <div style="margin-bottom:4px;color:#374151;">Please do not reply to this email.</div>
                    <div style="padding-top:10px;border-top:1px solid #e5e7eb;">
                        <div style="color:#4f46e5;font-weight:700;font-size:13px;margin-bottom:4px;">POT - Pay On Time</div>
                        <div style="font-size:11px;"><a href="https://payontime.com.au" style="color:#4f46e5;text-decoration:none;">https://payontime.com.au</a></div>
                    </div>
                </td>
            </tr>
        </table>
    </center>
</body>

</html>

@code {
    [Parameter]
    public required string Username { get; set; }

    [Parameter]
    public required string UserUsername { get; set; }

    [Parameter]
    public required string UserEmail { get; set; }
}