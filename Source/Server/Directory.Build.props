<Project>
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Pass a possibly-null value where a non-nullable one is required fails the build. `nullable` is the
		     SDK shorthand for the whole nullable warning set rather than one code, so the next nullable mistake
		     cannot arrive under a different CS86xx number. Nothing else in the solution raises a nullable warning
		     today, and the vulnerability warnings (NU1902/NU1903) stay warnings on purpose. -->
		<WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup>
		<!--IDE0063 - 'using' statement can be simplified-->
		<!--IDE0079 - remove unnecessary suppression-->
		<!--IDE0290 - use primary constructor-->
		<!--CS0618 - 'member' is obsolete-->
		<!--CA1873 - Evaluation of this argument may be expensive and unnecessary if logging is disabled-->
		<!--<NoWarn>$(NoWarn);IDE0063;IDE0079;IDE0290;CS0618</NoWarn>-->
		<NoWarn>$(NoWarn);IDE0290;CA1873</NoWarn>
	</PropertyGroup>

	<!-- Coverlet Code Coverage Exclusions -->
	<ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) or $(MSBuildProjectName.EndsWith('.TestUtils'))">
		<AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
	</ItemGroup>
</Project>
