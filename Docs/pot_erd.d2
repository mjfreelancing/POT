  source-arrowhead: {
    shape: cf-one-required
  }
  target-arrowhead: {
    shape: cf-many
  }
  style: {
    font-size: 24
  }
}

site.Site.Id <-> site.Setting.SiteId: ONE-TO-MANY {
  source-arrowhead: {
    shape: cf-one-required
  }
  target-arrowhead: {
    shape: cf-many
  }
  style: {
    font-size: 24
  }
}

site.Site.Id <-> auth.User.SiteId: ONE-TO-MANY {
  source-arrowhead: {
    shape: cf-one-required
  }
  target-arrowhead: {
    shape: cf-many
  }
  style: {
    font-size: 24
  }
}

role_perm.Permission.Id <-> role_perm.RolePermission.PermissionsId: ONE-TO-MANY {
  source-arrowhead: {
    shape: cf-one-required
  }
  target-arrowhead: {
    shape: cf-many
  }
  style: {
    font-size: 24
  }
