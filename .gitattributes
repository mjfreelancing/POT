# Enforce consistent line endings across platforms.
# Text files are stored with LF in the repository and checked out with CRLF on every platform, so the committed content
# never depends on anyone's core.autocrlf. The editor and formatter settings - .editorconfig, Source/Server/.editorconfig
# and Source/Client/pot-react/.prettierrc - say CRLF too, so a tool never writes a file differently from a checkout.
* text=auto eol=crlf

# Shell scripts should remain LF for POSIX environments.
*.sh text eol=lf
